// Prisma schema for the project data layer.
//
// Sessions and messages stay on disk (see src/shared/session-persistence.ts). SQLite stores projects,
// preview state, the message center, reviewer results, and a query projection of app-managed
// files; file bytes remain on disk. At runtime the datasource url is supplied programmatically (see
// prisma-client.ts), so DATABASE_URL is CLI-only.

generator client {
  provider      = "prisma-client-js"
  // Generate query engines for both macOS architectures so the x64 build can be cross-packaged on an
  // Apple Silicon CI runner (the scarce Intel `macos-13` runner is no longer needed). "native" is the
  // build host's engine (darwin-arm64 on mac CI, the distro engine on Linux); "darwin" adds x64 mac.
  // The release build prunes engines it doesn't need per platform (see .github/workflows/build.yml).
  binaryTargets = ["native", "darwin"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id               String            @id @default(cuid())
  name             String
  description      String            @default("")
  isExample        Boolean           @default(false)
  archivedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  permissionGrants PermissionGrant[]
}

model PermissionGrant {
  id             String    @id
  capabilityKind String
  capabilityKey  String
  qualifierMode  String    @default("none")
  qualifierValue String?
  scopeKind      String
  projectId      String?
  sessionId      String?
  fingerprint    String    @unique
  revision       Int       @default(1)
  createdAt      DateTime?
  project        Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([capabilityKind, capabilityKey, qualifierMode, qualifierValue, scopeKind, projectId, sessionId])
  @@index([projectId, sessionId])
}

// Per-project preview panel state (panel open/collapsed, active tab, opened file previews as JSON).
// Runtime-only tabs (notebook) are not stored; see src/shared/preview-state.ts.
model ProjectPreviewState {
  projectId    String   @id
  panelState   String
  activeItemId String?
  items        String   @default("[]")
  updatedAt    DateTime @updatedAt
}

// Legacy unread-task rows retained only as the source for the message-center startup migration.
// Runtime code removes each row after converting it into a generic inbox item.
model UnreadTaskSession {
  id        Int    @id @default(autoincrement())
  sessionId String @unique
}

// Backend-owned message center shared by desktop and Web clients connected to one single-user
// instance. `sequence` is the atomic mark-all boundary and retention order; `dedupeKey` makes every
// producer retry-safe without exposing provider payloads in the inbox.
model NotificationInboxItem {
  sequence    Int       @id @default(autoincrement())
  id          String    @unique
  dedupeKey   String    @unique
  kind        String
  source      String?
  projectId   String?
  sessionId   String?
  originId    String
  title       String
  summary     String
  createdAt   DateTime  @default(now())
  readAt      DateTime?
  actionState String?
  settledAt   DateTime?

  @@index([readAt, sequence])
  @@index([sessionId])
  @@index([projectId])
}

// One reviewer pass over a single completed turn. See src/main/reviewer/repository.ts. Checks live in
// a child table (Finding); the review carries the turn scope (JSON), the task lifecycle, and the outcome.
// Created at runtime via CREATE TABLE IF NOT EXISTS (see src/main/projects/prisma-client.ts), not migrate.
//
// v2 (issue 12): removed `summary` and `checks` JSON columns; all checks (pass/warn/fail) now live
// as rows in the Finding table.
// v3 (issue 13): replaced `reasoning` (self-authored prose) with `reviewerLog` (captured action stream
// as JSON array of ReviewerLogEntry). submit_findings no longer accepts `reasoning`.
model Review {
  id                 String                     @id @default(cuid())
  projectId          String
  sessionId          String
  turnMessageId      String
  scope              String                     @default("{}")
  lifecycle          String                     @default("running")
  outcome            String?
  errorMessage       String?
  model              String                     @default("")
  reviewerLog        String                     @default("[]")
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  findings           Finding[]
  causedDispositions ReviewFindingDisposition[]
  scopeSnapshot      ReviewScopeSnapshot?
}

// A unified check row — replaces both the old warn/fail-only Finding and the pass-only ReviewCheck
// JSON blob on Review. status is 'pass'|'warn'|'fail'. locator is optional (pass checks may omit it).
// resolution is meaningful only for warn/fail checks. Cascade-deleted with its Review.
// reflagCount (issue 15): number of times this claim was re-flagged in a Phase 3 fix loop; defaults to 0.
model Finding {
  id                   String                     @id @default(cuid())
  reviewId             String
  status               String                     @default("pass")
  resolution           String                     @default("open")
  claim                String                     @default("")
  evidence             String                     @default("")
  locator              String                     @default("{}")
  artifactVersionId    String?
  artifactBindingState String                     @default("legacy_unverified")
  sortIndex            Int                        @default(0)
  reflagCount          Int                        @default(0)
  review               Review                     @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  dispositions         ReviewFindingDisposition[]
}

model ProjectDeletionIntent {
  projectId String   @id
  createdAt DateTime @default(now())
}

model ManagedFile {
  seq               Int       @id @default(autoincrement())
  source            String
  sourceFileId      String
  sourceVersionId   String?
  checksum          String?
  projectId         String
  sessionId         String
  messageId         String?
  displayName       String
  storageKey        String
  mimeType          String?
  sizeBytes         BigInt
  mtimeMs           BigInt?
  sortAtMs          BigInt
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  deleteOperationId String?

  @@unique([projectId, source, sourceFileId])
  @@unique([projectId, source, storageKey])
  @@index([projectId, deletedAt, sortAtMs, seq])
  @@index([projectId, source, deletedAt, sortAtMs, seq])
  @@index([projectId, sessionId, source, deletedAt, sortAtMs, seq])
  @@index([sessionId, deletedAt])
}

model ManagedFileSessionSync {
  projectId         String
  sessionId         String
  filesRevision     Int
  groupSortAtMs     BigInt
  artifactCount     Int       @default(0)
  uploadCount       Int       @default(0)
  syncedAt          DateTime  @default(now())
  deletedAt         DateTime?
  deleteOperationId String?

  @@id([projectId, sessionId])
  @@index([projectId, deletedAt, groupSortAtMs, sessionId])
}

// Narrow origin lifecycle retained after a live Session JSON is deleted. This is not a second
// editable Session model; it exists only to preserve managed-file ownership and deletion state.
model FileOriginSession {
  projectId             String
  sessionId             String
  titleSnapshot         String?
  state                 String                    @default("active")
  deletedAt             DateTime?
  deletionOperationId   String?
  retainedReviewIdsJson String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  lineages              ArtifactLineage[]
  uploads               UploadFile[]
  messageSnapshots      ArtifactMessageSnapshot[]
  sourceInputs          ArtifactVersionInput[]

  @@id([projectId, sessionId])
  @@index([projectId, state])
}

// Stable identity for same-named generated Artifact saves inside one Project Session.
model ArtifactLineage {
  id                 String            @id
  projectId          String
  sessionId          String
  normalizedFilename String
  filename           String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  versions           ArtifactVersion[]
  originSession      FileOriginSession @relation(fields: [projectId, sessionId], references: [projectId, sessionId], onDelete: Restrict)

  @@unique([projectId, sessionId, normalizedFilename])
  @@index([projectId, sessionId])
}

model UploadFile {
  id               String            @id
  projectId        String
  sessionId        String
  filename         String
  originalFilename String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  versions         UploadVersion[]
  originSession    FileOriginSession @relation(fields: [projectId, sessionId], references: [projectId, sessionId], onDelete: Restrict)

  @@index([projectId, sessionId])
}

model UploadVersion {
  id                String                 @id
  uploadFileId      String
  versionNumber     Int
  state             String                 @default("staging")
  contentStorageKey String
  filename          String
  originalFilename  String
  contentType       String?
  sizeBytes         BigInt
  checksum          String
  createdAt         DateTime?
  registeredAt      DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  uploadFile        UploadFile             @relation(fields: [uploadFileId], references: [id], onDelete: Cascade)
  sourceInputs      ArtifactVersionInput[] @relation("UploadVersionSourceInputs")

  @@unique([uploadFileId, versionNumber])
  @@index([uploadFileId, state, registeredAt])
}

model ArtifactMessageSnapshot {
  id                String            @id
  projectId         String
  sessionId         String
  rootFrameId       String
  agentFrameId      String
  messageBranchId   String
  terminalMessageId String
  state             String            @default("staging")
  storageKey        String
  checksum          String            @default("")
  messageCount      Int
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  versions          ArtifactVersion[]
  originSession     FileOriginSession @relation(fields: [projectId, sessionId], references: [projectId, sessionId], onDelete: Restrict)

  @@unique([projectId, sessionId, agentFrameId, messageBranchId, terminalMessageId])
  @@index([projectId, sessionId, state])
}

// One immutable generated Artifact save event. Evidence/content fields become immutable once the
// staging row is published; finalize only advances state and message ownership.
model ArtifactVersion {
  id                             String                   @id
  artifactId                     String
  versionNumber                  Int
  filename                       String
  artifactRunId                  String
  writeOperationId               String?                  @unique
  writeRequestChecksum           String?
  rootFrameId                    String
  agentFrameId                   String
  messageBranchId                String
  runtimeSegmentId               String
  promptMessageId                String
  notebookSessionId              String?
  producerRunId                  String?
  producerRunIndex               Int?
  messageId                      String?
  messageSnapshotId              String?
  state                          String                   @default("staging")
  contentStorageKey              String
  evidenceStorageKey             String
  contentType                    String?
  sizeBytes                      BigInt
  checksum                       String
  evidenceJson                   String
  evidenceChecksum               String
  evidenceSchemaVersion          Int                      @default(1)
  executionSnapshotJson          String?
  executionSnapshotChecksum      String?
  executionSnapshotStorageKey    String?
  executionSnapshotSchemaVersion Int?
  createdAt                      DateTime                 @default(now())
  updatedAt                      DateTime                 @updatedAt
  artifact                       ArtifactLineage          @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  messageSnapshot                ArtifactMessageSnapshot? @relation(fields: [messageSnapshotId], references: [id], onDelete: SetNull)
  inputs                         ArtifactVersionInput[]   @relation("ProducedArtifactInputs")
  sourceInputs                   ArtifactVersionInput[]   @relation("ArtifactVersionSourceInputs")

  @@unique([artifactId, versionNumber])
  @@index([artifactId, createdAt])
  @@index([artifactRunId, state])
  @@index([rootFrameId, agentFrameId, messageBranchId, promptMessageId])
  @@index([messageId])
  @@index([messageSnapshotId])
}

model ArtifactVersionInput {
  id                      String            @id
  artifactVersionId       String
  ordinal                 Int
  inputFileVersionId      String
  sourceKind              String
  sourceFileId            String
  sourceArtifactVersionId String?
  sourceUploadVersionId   String?
  sourceVersionNumber     Int?
  sourceCreatedAt         DateTime?
  sourceProjectId         String
  sourceSessionId         String
  filename                String
  contentType             String?
  sizeBytes               BigInt
  checksum                String
  storageKey              String
  strongestAssociation    String
  artifactVersion         ArtifactVersion   @relation("ProducedArtifactInputs", fields: [artifactVersionId], references: [id], onDelete: Cascade)
  sourceArtifactVersion   ArtifactVersion?  @relation("ArtifactVersionSourceInputs", fields: [sourceArtifactVersionId], references: [id], onDelete: Restrict)
  sourceUploadVersion     UploadVersion?    @relation("UploadVersionSourceInputs", fields: [sourceUploadVersionId], references: [id], onDelete: Restrict)
  sourceOrigin            FileOriginSession @relation(fields: [sourceProjectId, sourceSessionId], references: [projectId, sessionId], onDelete: Restrict)

  @@unique([artifactVersionId, sourceKind, inputFileVersionId])
  @@unique([artifactVersionId, ordinal])
  @@index([sourceKind, inputFileVersionId])
  @@index([sourceArtifactVersionId])
  @@index([sourceUploadVersionId])
  @@index([sourceProjectId, sourceSessionId])
}

model ReviewFindingDisposition {
  id                        String   @id
  sourceFindingId           String
  causeReviewId             String?
  sequence                  Int
  trigger                   String
  outcome                   String
  note                      String?
  assessedArtifactVersionId String?
  createdAt                 DateTime @default(now())
  sourceFinding             Finding  @relation(fields: [sourceFindingId], references: [id], onDelete: Cascade)
  causeReview               Review?  @relation(fields: [causeReviewId], references: [id], onDelete: Restrict)

  @@unique([sourceFindingId, sequence])
  @@index([causeReviewId, createdAt])
  @@index([assessedArtifactVersionId])
}

model ReviewScopeSnapshot {
  id                 String   @id
  projectId          String
  sessionId          String
  reviewId           String   @unique
  scopeTurnMessageId String
  state              String   @default("staging")
  snapshotJson       String
  checksum           String
  storageKey         String
  schemaVersion      Int      @default(1)
  blockCount         Int
  createdAt          DateTime @default(now())
  review             Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([projectId, sessionId, state])
}

// A remote compute job submitted via host.compute.create(id).submit_job(). Phase 3a (issue 01 of
// compute-jobs) adds this table as a pure-additive migration — it references nothing, and nothing
// references it, so adding it is safe against any pre-existing DB. The table tracks the full
// lifecycle: submitted → running → success/failed/timeout/error.
// Columns for harvest (harvestedAt, outputManifest) and concurrency (queued) are included now per
// design.md §1 to avoid a schema change in 3b/3c — they are null until those phases fill them.
// Security: no credentials are stored; command is stored for audit; commandHash for dedup.
model ComputeJob {
  id                     String    @id @default(cuid())
  providerId             String
  shape                  String
  sessionId              String
  projectId              String
  status                 String    @default("submitted")
  intent                 String
  command                String
  commandHash            String
  environment            String?
  resourceRequest        String?
  inputManifest          String?
  outputManifest         String?
  harvestConfig          String?
  timeoutSeconds         Int?
  remoteWorkdir          String?
  remoteHandle           String?
  exitCode               Int?
  stdoutTail             String?
  stderrTail             String?
  errorCode              String?
  // lastPollError: set when SSH connectivity fails during a poll tick (design.md §8 boundary 2).
  // The job status is NOT changed — this field surfaces the transient error to the UI.
  // Cleared on the next successful poll. retry_after_user_action is always true for this field.
  lastPollError          String?
  // 3b harvest columns (compute-harvest issue 01): pure-additive, null until Phase 3b fills them.
  // harvestError: summary of a harvest_failed outcome; non-null means harvest completed with errors.
  harvestError           String?
  // leftOnRemote: JSON [{uri, size_mb, reason}] — files left on the remote side after harvest.
  leftOnRemote           String?
  // notifiedAt: set when the compute_done notification has been enqueued to the inbox.
  notifiedAt             DateTime?
  // notificationConsumedAt: set by wait_for_notification when the notification is consumed.
  notificationConsumedAt DateTime?
  createdAt              DateTime  @default(now())
  submittedAt            DateTime?
  startedAt              DateTime?
  finishedAt             DateTime?
  harvestedAt            DateTime?

  @@index([providerId])
  @@index([sessionId])
  @@index([status])
}

// A registered remote SSH compute host (Compute settings tab). Phase 1 (issue 01) manages the record
// only — no SSH connection is made. Pure-additive table: it references nothing and nothing references
// it, so adding it is byte-compatible with any pre-existing DB (see prisma-client.ts runtime DDL and
// its compatibility tests). Security: only an ssh alias + optional non-secret overrides are stored;
// no credentials or private keys ever land here (design.md §1/§3).
model ComputeHost {
  id               String    @id @default(cuid())
  providerId       String    @unique // "ssh:<alias>"
  displayName      String
  shape            String    @default("unclassified") // unclassified | direct_ssh | scheduler_cluster | bridge_runner
  sshAlias         String
  sshOverrides     String? // JSON: { user?, port?, identityFile? } — never credentials
  scratchRoot      String?
  scratchPinned    Boolean   @default(false)
  concurrencyLimit Int? // stored but not enforced in Phase 1
  probeResult      String? // JSON probe snapshot, written by a later issue
  detailsDoc       String    @default("") // markdown notes, <= 32768 chars
  detailsUpdatedAt DateTime?
  detailsUpdatedBy String? // user | agent
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// Immutable, secret-free snapshot of the effective route policy used for one or more agent runs.
// Message content remains in Session JSON; policyJson contains only routing metadata, the resolved
// decision, and model targets.
model RoutingPolicySnapshot {
  id            String     @id
  projectId     String?
  sessionId     String?
  workClass     String
  policyId      String
  policyVersion String
  policySource  String
  policyJson    String
  policyHash    String
  createdAt     DateTime   @default(now())
  agentRuns     AgentRun[]

  @@index([projectId, sessionId, createdAt])
  @@index([policyId, policyVersion])
}

// One orchestrated unit of work. promptMessageId references authoritative Session JSON instead of
// copying task text into SQLite.
model AgentRun {
  id                    String                @id
  parentAgentRunId      String?
  policySnapshotId      String
  projectId             String
  sessionId             String
  promptMessageId       String?
  role                  String
  workClass             String
  runtime               String
  status                String                @default("queued")
  budgetJson            String?
  outputArtifactIdsJson String                @default("[]")
  createdAt             DateTime              @default(now())
  startedAt             DateTime?
  finishedAt            DateTime?
  parentAgentRun        AgentRun?             @relation("AgentRunParent", fields: [parentAgentRunId], references: [id], onDelete: SetNull)
  childAgentRuns        AgentRun[]            @relation("AgentRunParent")
  policySnapshot        RoutingPolicySnapshot @relation(fields: [policySnapshotId], references: [id], onDelete: Restrict)
  modelAttempts         ModelAttempt[]
  runtimeThreadLinks    RuntimeThreadLink[]

  @@index([projectId, sessionId, createdAt])
  @@index([parentAgentRunId])
  @@index([policySnapshotId])
  @@index([status])
}

// One exact provider/model attempt. Only a request digest is stored; prompts and attachments stay in
// Session-managed storage. sequence preserves fallback order and is unique within an AgentRun.
model ModelAttempt {
  id                     String    @id
  agentRunId             String
  sequence               Int
  trigger                String
  backend                String
  providerId             String
  model                  String
  reasoningEffort        String
  targetCapabilitiesJson String    @default("[]")
  targetDataBoundary     String
  targetContextWindow    Int?
  requestHash            String
  result                 String    @default("running")
  failureCategory        String?
  sideEffectsStarted     Boolean   @default(false)
  fallbackApprovalId     String?   @unique
  fallbackApprovalJson   String?
  latencyMs              Int?
  inputTokens            BigInt?
  outputTokens           BigInt?
  costUsdMicros          BigInt?
  startedAt              DateTime  @default(now())
  finishedAt             DateTime?
  agentRun               AgentRun  @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@unique([agentRunId, sequence])
  @@index([agentRunId, startedAt])
  @@index([providerId, model, startedAt])
  @@index([result])
}

// Links an application run to its Codex/OpenCode/Claude thread without persisting thread messages.
model RuntimeThreadLink {
  id                    String    @id
  agentRunId            String
  appSessionId          String
  backend               String
  runtimeThreadId       String
  parentRuntimeThreadId String?
  ephemeral             Boolean   @default(false)
  createdAt             DateTime  @default(now())
  closedAt              DateTime?
  agentRun              AgentRun  @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@unique([backend, runtimeThreadId])
  @@index([agentRunId])
  @@index([appSessionId, createdAt])
}
